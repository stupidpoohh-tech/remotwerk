{
  "name": "remotwerk",
  "productName": "Remotwerk",
  "version": "0.9.1",
  "description": "커플 데스크톱 캐릭터 앱 — 상대 화면 위에 상주하며 몸짓 신호를 주고받는 현존(presence) 아바타",
  "main": "src/main/main.js",
  "author": "Remotwerk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tools/selftest.js && node tools/overlay-startup-test.js",
    "smoke": "node tools/app-smoke.js",
    "dev": "electron . --dev",
    "icon": "node tools/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "com.remotwerk.app",
    "productName": "Remotwerk",
    "copyright": "Copyright © Remotwerk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remotwerk"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "stupidpoohh-tech",
        "repo": "remotwerk",
        "releaseType": "release"
      }
    ]
  }
}
